@using LamaWMS.Domain.Entities

@{
    ViewData["Title"] = "Резервирование ткани";

    var product =
        (Product)ViewBag.Product;

    var rolls =
        (List<Roll>)ViewBag.Rolls;
}

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h1>Резервирование ткани</h1>

        <div class="text-muted">
            Изделие:
            <strong>@product.Name</strong>
        </div>
    </div>

    <a asp-controller="Products"
       asp-action="Details"
       asp-route-id="@product.Id"
       class="btn btn-secondary">
        Назад
    </a>

</div>


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


@*
    Пока форма используется для построения нового интерфейса.
    Массовый POST подключим следующим шагом.
*@
<form asp-action="Create"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="productId"
           value="@product.Id" />

    <div class="card mb-4">

        <div class="card-body">

            <label for="requestNumber"
                   class="form-label fw-semibold">
                Номер заявки
            </label>

            <input type="text"
                   id="requestNumber"
                   name="requestNumber"
                   class="form-control"
                   style="max-width: 400px;"
                   maxlength="100"
                   placeholder="Введите номер заявки"
                   required />

            <div class="form-text">
                Номер заявки будет применён ко всем создаваемым резервам.
            </div>

        </div>

    </div>


    @if (!product.ProductFabrics.Any())
    {
        <div class="alert alert-light border">
            Для изделия не указана потребность в ткани.
        </div>
    }
    else
    {
        @foreach (var productFabric in product.ProductFabrics
            .OrderBy(x => x.Fabric.Name))
        {
            var alreadyReserved =
                productFabric.RollReservations
                    .Sum(x => x.ReservedLength);

            var remainingNeed =
                productFabric.RequiredLength - alreadyReserved;

            var fabricRolls =
                rolls
                    .Where(x => x.FabricId == productFabric.FabricId)
                    .ToList();

            <div class="card mb-4">

                <div class="card-header bg-white py-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <h4 class="mb-0">
                            @productFabric.Fabric.Name
                        </h4>

                        @if (remainingNeed <= 0)
                        {
                            <span class="badge text-bg-success">
                                Потребность обеспечена
                            </span>
                        }

                    </div>

                </div>


                <div class="card-body">

                    <div class="row mb-4">

                        <div class="col-md-4">

                            <div class="text-muted">
                                Требуется
                            </div>

                            <strong>
                                @productFabric.RequiredLength.ToString("0.00") м
                            </strong>

                        </div>


                        <div class="col-md-4">

                            <div class="text-muted">
                                Уже зарезервировано
                            </div>

                            <strong>
                                @alreadyReserved.ToString("0.00") м
                            </strong>

                        </div>


                        <div class="col-md-4">

                            <div class="text-muted">
                                Осталось зарезервировать
                            </div>

                            <strong>
                                @Math.Max(0, remainingNeed).ToString("0.00") м
                            </strong>

                        </div>

                    </div>


                    @if (remainingNeed <= 0)
                    {
                        <div class="alert alert-success mb-0">
                            Потребность в этой ткани уже полностью обеспечена.
                        </div>
                    }
                    else if (!fabricRolls.Any())
                    {
                        <div class="alert alert-warning mb-0">
                            <strong>Нет доступных рулонов.</strong>
                            На складе нет рулонов этой ткани.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">

                                    <tr>
                                        <th>Рулон</th>
                                        <th>Ячейка</th>
                                        <th>Физический остаток</th>
                                        <th>В резерве</th>
                                        <th>Доступно</th>

                                        <th style="width: 220px;">
                                            Новый резерв
                                        </th>
                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var roll in fabricRolls)
                                    {
                                        var reservedOnRoll =
                                            roll.Reservations
                                                .Sum(x => x.ReservedLength);

                                        var available =
                                            roll.CurrentLength - reservedOnRoll;

                                        <tr>

                                            <td>
                                                <a asp-controller="Rolls"
                                                   asp-action="Details"
                                                   asp-route-id="@roll.Id"
                                                   class="text-decoration-none fw-semibold">

                                                    @roll.Number

                                                </a>
                                            </td>


                                            <td>
                                                @(roll.Cell?.Code ?? "Не размещён")
                                            </td>


                                            <td>
                                                @roll.CurrentLength.ToString("0.00") м
                                            </td>


                                            <td>
                                                @reservedOnRoll.ToString("0.00") м
                                            </td>


                                            <td>

                                                @if (available > 0)
                                                {
                                                    <strong>
                                                        @available.ToString("0.00") м
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <span class="text-danger">
                                                        0.00 м
                                                    </span>
                                                }

                                            </td>


                                            <td>

                                                @if (available > 0)
                                                {
                                                    <input type="number"
                                                           name="reservations[@roll.Id]"
                                                           class="form-control"
                                                           step="0.01"
                                                           min="0"
                                                           max="@Math.Min(available, remainingNeed).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                           placeholder="0,00" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted">
                                                        Недоступен
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>
        }
    }


    @if (product.ProductFabrics.Any(x =>
        x.RequiredLength >
        x.RollReservations.Sum(r => r.ReservedLength)))
    {
        <div class="d-flex justify-content-end mb-5">

            <button type="submit"
                    class="btn btn-primary btn-lg">
                Зарезервировать выбранное
            </button>

        </div>
    }

</form>