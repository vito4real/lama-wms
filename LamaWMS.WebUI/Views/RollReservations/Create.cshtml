@using LamaWMS.Domain.Entities

@{
    ViewData["Title"] = "Резервирование ткани";

    var product =
        (Product)ViewBag.Product;

    var rolls =
        (List<Roll>)ViewBag.Rolls;

    var requestNumber =
        ViewBag.RequestNumber as string;
}


<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h1>Резервирование ткани</h1>

        <div class="text-muted">
            Изделие:
            <strong>@product.Name</strong>
        </div>
    </div>

    <a asp-controller="Products"
       asp-action="Details"
       asp-route-id="@product.Id"
       class="btn btn-secondary">
        Назад
    </a>

</div>


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}


@if (string.IsNullOrWhiteSpace(requestNumber))
{
    @* ЭТАП 1: выбор номера заявки *@

    <div class="card mb-4">

        <div class="card-body">

            <form asp-action="Create"
                  method="get">

                <input type="hidden"
                       name="productId"
                       value="@product.Id" />

                <label for="requestNumber"
                       class="form-label fw-semibold">
                    Номер заявки
                </label>

                <div class="d-flex gap-2"
                     style="max-width: 550px;">

                    <input type="text"
                           id="requestNumber"
                           name="requestNumber"
                           class="form-control"
                           maxlength="100"
                           placeholder="Введите номер заявки"
                           required />

                    <button type="submit"
                            class="btn btn-primary">
                        Продолжить
                    </button>

                </div>

                <div class="form-text">
                    Укажите заявку, для которой выполняется резервирование.
                </div>

            </form>

        </div>

    </div>
}
else
{
    @* ЭТАП 2: массовое резервирование для выбранной заявки *@

    <div class="card mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <div class="text-muted">
                        Резервирование для заявки
                    </div>

                    <strong class="fs-5">
                        № @requestNumber
                    </strong>

                </div>

                <a asp-action="Create"
                   asp-route-productId="@product.Id"
                   class="btn btn-outline-secondary">
                    Изменить заявку
                </a>

            </div>

        </div>

    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="productId"
               value="@product.Id" />

        <input type="hidden"
               name="requestNumber"
               value="@requestNumber" />


        @if (!product.ProductFabrics.Any())
        {
            <div class="alert alert-light border">
                Для изделия не указана потребность в ткани.
            </div>
        }
        else
        {
            @foreach (var productFabric in product.ProductFabrics
                .OrderBy(x => x.Fabric.Name))
            {
                var alreadyReserved =
                    productFabric.RollReservations
                        .Where(x => x.RequestNumber == requestNumber)
                        .Sum(x => x.ReservedLength);

                var remainingNeed =
                    productFabric.RequiredLength - alreadyReserved;

                var fabricRolls =
                    rolls
                        .Where(x => x.FabricId == productFabric.FabricId)
                        .ToList();


                <div class="card mb-4">

                    <div class="card-header bg-white py-3">

                        <div class="d-flex justify-content-between align-items-center">

                            <h4 class="mb-0">
                                @productFabric.Fabric.Name
                            </h4>

                            @if (remainingNeed <= 0)
                            {
                                <span class="badge text-bg-success">
                                    По заявке зарезервировано
                                </span>
                            }

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="row mb-4">

                            <div class="col-md-4">

                                <div class="text-muted">
                                    Требуется
                                </div>

                                <strong>
                                    @productFabric.RequiredLength.ToString("0.00") м
                                </strong>

                            </div>


                            <div class="col-md-4">

                                <div class="text-muted">
                                    Зарезервировано по заявке
                                </div>

                                <strong>
                                    @alreadyReserved.ToString("0.00") м
                                </strong>

                            </div>


                            <div class="col-md-4">

                                <div class="text-muted">
                                    Осталось по заявке
                                </div>

                                <strong>
                                    @Math.Max(0, remainingNeed).ToString("0.00") м
                                </strong>

                            </div>

                        </div>


                        @if (remainingNeed <= 0)
                        {
                            <div class="alert alert-success mb-0">
                                Для заявки №@requestNumber необходимое количество
                                этой ткани уже зарезервировано.
                            </div>
                        }
                        else if (!fabricRolls.Any())
                        {
                            <div class="alert alert-warning mb-0">

                                <strong>Нет доступных рулонов.</strong>
                                На складе нет рулонов этой ткани.

                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table table-hover align-middle mb-0">

                                    <thead class="table-light">

                                        <tr>
                                            <th>Рулон</th>
                                            <th>Ячейка</th>
                                            <th>Физический остаток</th>
                                            <th>В резерве</th>
                                            <th>Доступно</th>

                                            <th style="width: 220px;">
                                                Новый резерв
                                            </th>
                                        </tr>

                                    </thead>


                                    <tbody>

                                        @foreach (var roll in fabricRolls)
                                        {
                                            var reservedOnRoll =
                                                roll.Reservations
                                                    .Sum(x => x.ReservedLength);

                                            var available =
                                                roll.CurrentLength - reservedOnRoll;

                                            <tr>

                                                <td>

                                                    <a asp-controller="Rolls"
                                                       asp-action="Details"
                                                       asp-route-id="@roll.Id"
                                                       class="text-decoration-none fw-semibold">

                                                        @roll.Number

                                                    </a>

                                                </td>


                                                <td>
                                                    @(roll.Cell?.Code ?? "Не размещён")
                                                </td>


                                                <td>
                                                    @roll.CurrentLength.ToString("0.00") м
                                                </td>


                                                <td>
                                                    @reservedOnRoll.ToString("0.00") м
                                                </td>


                                                <td>

                                                    @if (available > 0)
                                                    {
                                                        <strong>
                                                            @available.ToString("0.00") м
                                                        </strong>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">
                                                            0.00 м
                                                        </span>
                                                    }

                                                </td>


                                                <td>

                                                    @if (available > 0)
                                                    {
                                                        <input type="number"
                                                               name="reservations[@roll.Id]"
                                                               class="form-control"
                                                               step="0.01"
                                                               min="0"
                                                               max="@Math.Min(available, remainingNeed).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                               placeholder="0,00" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">
                                                            Недоступен
                                                        </span>
                                                    }

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>

                </div>
            }
        }


        @{
            var hasRemainingNeed =
                product.ProductFabrics.Any(x =>
                    x.RequiredLength >
                    x.RollReservations
                        .Where(r => r.RequestNumber == requestNumber)
                        .Sum(r => r.ReservedLength));
        }


        @if (hasRemainingNeed)
        {
            <div class="d-flex justify-content-end mb-5">

                <button type="submit"
                        class="btn btn-primary btn-lg">
                    Зарезервировать выбранное
                </button>

            </div>
        }

    </form>
}