@model IEnumerable<LamaWMS.Domain.Entities.Fabric>

@{
    ViewData["Title"] = "Ткани";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ткани</h1>

    <a asp-action="Create" class="btn btn-primary">
        Добавить ткань
    </a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Название</th>
            <th>Рулонов</th>
            <th>Общий метраж</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var fabric in Model)
        {
            <tr>
                <td>
                    <strong>@fabric.Name</strong>
                </td>

                <td>
                    @if (fabric.Rolls.Count > 0)
                    {
                        <strong>
                            @fabric.Rolls.Count
                        </strong>
                    }
                    else
                    {
                        <span class="text-muted">0</span>
                    }
                </td>

                @{
                    var totalLength = fabric.Rolls.Sum(x => x.CurrentLength);
                }

                <td>
                    @if (totalLength > 0)
                    {
                        <strong>@totalLength.ToString("0.00") м</strong>
                    }
                    else
                    {
                        <span class="text-muted">0,00 м</span>
                    }
                </td>

                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@fabric.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Открыть
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@fabric.Id"
                       class="btn btn-sm btn-outline-primary">
                        Изменить
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@fabric.Id"
                       class="btn btn-sm btn-outline-danger">
                        Удалить
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>