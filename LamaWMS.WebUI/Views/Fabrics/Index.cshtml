@model IEnumerable<LamaWMS.Domain.Entities.Fabric>

@{
    ViewData["Title"] = "Наименования тканей";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Наименования тканей</h1>

    <a asp-action="Create" class="btn btn-primary">
        Добавить наименование тканей
    </a>
</div>

<form method="get" class="mb-3">
    <div class="d-flex flex-column flex-sm-row gap-2">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control flex-grow-1"
               placeholder="Поиск по названию ткани..." />

        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-primary">
                Найти
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Сбросить
                </a>
            }
        </div>

    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Название</th>
            <th>Рулонов</th>
            <th>Общий метраж</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var fabric in Model)
        {
            <tr>
                <td>
                    <strong>@fabric.Name</strong>
                </td>

                <td>
                    @if (fabric.Rolls.Count > 0)
                    {
                        <strong>
                            @fabric.Rolls.Count
                        </strong>
                    }
                    else
                    {
                        <span class="text-muted">0</span>
                    }
                </td>

                @{
                    var totalLength = fabric.Rolls.Sum(x => x.CurrentLength);
                }

                <td>
                    @if (totalLength > 0)
                    {
                        <strong>@totalLength.ToString("0.00") м</strong>
                    }
                    else
                    {
                        <span class="text-muted">0,00 м</span>
                    }
                </td>

                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@fabric.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Открыть
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@fabric.Id"
                       class="btn btn-sm btn-outline-primary">
                        Изменить
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@fabric.Id"
                       class="btn btn-sm btn-outline-danger">
                        Удалить
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>