@model LamaWMS.Domain.Entities.Product

@{
    ViewData["Title"] = "Изменить изделие";
}

<h1>Изменить изделие</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="Name"
               class="form-label">
            Название
        </label>

        <input asp-for="Name"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Сохранить
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Назад
    </a>
</form>