@model LamaWMS.Domain.Entities.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <h1 class="mb-1">@Model.Name</h1>

        <div class="text-muted">
            Нормы расхода ткани
        </div>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="AddFabric"
           asp-route-productId="@Model.Id"
           class="btn btn-secondary">
            Добавить ткань
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Назад
        </a>

    </div>

</div>


@if (!Model.ProductFabrics.Any())
{
    <div class="alert alert-light border">
        Для изделия пока не указаны нормы расхода ткани.
    </div>
}
else
{
    <div class="card mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0">
                Ткани изделия
            </h5>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Ткань</th>
                        <th style="width: 250px;">
                            Норма расхода
                        </th>
                        <th style="width: 120px;"></th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var productFabric in
                        Model.ProductFabrics.OrderBy(x => x.Fabric.Name))
                    {
                        <tr>

                            <td>
                                <strong>
                                    @productFabric.Fabric.Name
                                </strong>
                            </td>

                            <td>
                                @productFabric.RequiredLength.ToString("0.00") м
                            </td>

                            <td class="text-end">

                                <form asp-action="DeleteFabric"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@productFabric.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Удалить
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@if (Model.ProductFabrics.Any())
{
    <div class="mt-4">

        <a asp-controller="RollReservations"
           asp-action="Create"
           asp-route-productId="@Model.Id"
           class="btn btn-primary btn-lg">
            Зарезервировать ткани
        </a>

    </div>
}