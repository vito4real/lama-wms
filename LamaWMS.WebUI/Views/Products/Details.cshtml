@model LamaWMS.Domain.Entities.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>@Model.Name</h1>

        <div class="text-muted">
            Потребность в ткани и резервы
        </div>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="AddFabric"
           asp-route-productId="@Model.Id"
           class="btn btn-primary">
            Добавить ткань
        </a>

        <a asp-controller="RollReservations"
           asp-action="Create"
           asp-route-productId="@Model.Id"
           class="btn btn-outline-primary">
            Зарезервировать ткани
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Назад
        </a>

    </div>

</div>

@if (!Model.ProductFabrics.Any())
{
    <div class="alert alert-light border">
        Для изделия пока не указаны ткани.
    </div>
}
else
{
    @foreach (var productFabric in Model.ProductFabrics)
    {
        var reserved = productFabric.RollReservations
            .Sum(x => x.ReservedLength);

        var remaining =
            productFabric.RequiredLength - reserved;

        <div class="card mb-3">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <h5 class="card-title mb-1">
                            @productFabric.Fabric.Name
                        </h5>
                    </div>

                    <form asp-action="DeleteFabric"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@productFabric.Id" />

                        <button type="submit"
                                class="btn btn-sm btn-outline-danger">
                            Удалить
                        </button>

                    </form>

                </div>

                <hr />

                <div class="row align-items-center">

                    <div class="col-md-3">
                        <div class="text-muted">
                            Требуется
                        </div>

                        <strong>
                            @productFabric.RequiredLength.ToString("0.00") м
                        </strong>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted">
                            Зарезервировано
                        </div>

                        <strong>
                            @reserved.ToString("0.00") м
                        </strong>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted">
                            Осталось
                        </div>

                        <strong>
                            @remaining.ToString("0.00") м
                        </strong>
                    </div>

                    <div class="col-md-3 text-end">

                        @if (remaining <= 0)
                        {
                            <span class="badge text-bg-success">
                                Потребность обеспечена
                            </span>
                        }

                    </div>

                </div>

                @if (productFabric.RollReservations.Any())
                {
                    <hr />

                    <div class="table-responsive">

                        <table class="table table-sm table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>Рулон</th>
                                    <th>Ячейка</th>
                                    <th>№ заявки</th>
                                    <th>Зарезервировано</th>
                                    <th>Дата</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var reservation in
                                    productFabric.RollReservations
                                        .OrderByDescending(x => x.CreatedAt))
                                {
                                    <tr>

                                        <td>
                                            <a asp-controller="Rolls"
                                               asp-action="Details"
                                               asp-route-id="@reservation.RollId"
                                               class="text-decoration-none fw-semibold">

                                                @reservation.Roll.Number

                                            </a>
                                        </td>

                                        <td>
                                            @(reservation.Roll.Cell?.Code ?? "Не размещён")
                                        </td>

                                        <td>
                                            <strong>
                                                @reservation.RequestNumber
                                            </strong>
                                        </td>

                                        <td>
                                            @reservation.ReservedLength.ToString("0.00") м
                                        </td>

                                        <td class="text-muted text-nowrap">
                                            @(reservation.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                        </td>

                                        <td class="text-end">

                                            <form asp-controller="RollReservations"
                                                  asp-action="Delete"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@reservation.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Снять резерв
                                                </button>

                                            </form>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>
    }
}