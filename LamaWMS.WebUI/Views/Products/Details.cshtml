@model LamaWMS.Domain.Entities.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.Name</h1>

        <div class="text-muted">
            Потребность в ткани и резервы
        </div>
    </div>

    <div>
        <a asp-action="AddFabric"
           asp-route-productId="@Model.Id"
           class="btn btn-primary">
            Добавить ткань
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Назад
        </a>
    </div>
</div>

@if (!Model.ProductFabrics.Any())
{
    <div class="alert alert-light border">
        Для изделия пока не указаны ткани.
    </div>
}
else
{
    @foreach (var productFabric in Model.ProductFabrics)
    {
        var reserved = productFabric.RollReservations
            .Sum(x => x.ReservedLength);

        var remaining = productFabric.RequiredLength - reserved;

        <div class="card mb-3">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>
                        <h5 class="card-title mb-1">
                            @productFabric.Fabric.Name
                        </h5>

                        <div class="text-muted">
                            @productFabric.Fabric.Color
                        </div>
                    </div>

                    <form asp-action="DeleteFabric"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@productFabric.Id" />

                        <button type="submit"
                                class="btn btn-sm btn-outline-danger">
                            Удалить
                        </button>

                    </form>
                </div>

                <hr />

                <div class="row">

                    <div class="col-md-3">
                        <div class="text-muted">
                            Требуется
                        </div>

                        <strong>
                            @productFabric.RequiredLength.ToString("0.00") м
                        </strong>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted">
                            Зарезервировано
                        </div>

                        <strong>
                            @reserved.ToString("0.00") м
                        </strong>
                    </div>

                    <div class="col-md-3">
                        <div class="text-muted">
                            Осталось
                        </div>

                        <strong>
                            @remaining.ToString("0.00") м
                        </strong>
                    </div>

                    <div class="col-md-3 text-end">
                        <a asp-controller="RollReservations"
                           asp-action="Create"
                           asp-route-productFabricId="@productFabric.Id"
                           class="btn btn-outline-primary">
                            Зарезервировать рулон
                        </a>
                    </div>

                </div>

                @if (productFabric.RollReservations.Any())
                {
                    <hr />

                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Рулон</th>
                                <th>Ячейка</th>
                                <th>Зарезервировано</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var reservation in productFabric.RollReservations)
                            {
                                <tr>
                                    <td>
                                        @reservation.Roll.Number
                                    </td>

                                    <td>
                                        @(reservation.Roll.Cell?.Code ?? "Не размещён")
                                    </td>

                                    <td>
                                        @reservation.ReservedLength.ToString("0.00") м
                                    </td>

                                    <td class="text-end">
                                        <form asp-controller="RollReservations"
                                              asp-action="Delete"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@reservation.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Снять резерв
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

            </div>
        </div>
    }
}