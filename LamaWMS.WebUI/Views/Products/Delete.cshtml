@model LamaWMS.Domain.Entities.Product

@{
    ViewData["Title"] = "Удаление изделия";
}

<h1>Удаление изделия</h1>

<div class="alert alert-warning">
    Вы действительно хотите удалить изделие?
</div>

<dl class="row">
    <dt class="col-sm-3">
        Название
    </dt>

    <dd class="col-sm-9">
        <strong>@Model.Name</strong>
    </dd>

    <dt class="col-sm-3">
        Тканей
    </dt>

    <dd class="col-sm-9">
        @Model.ProductFabrics.Count
    </dd>
</dl>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            class="btn btn-danger">
        Удалить
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Назад
    </a>
</form>