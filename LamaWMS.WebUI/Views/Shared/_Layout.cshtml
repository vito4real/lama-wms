<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - СООО "Лама-мебель"</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LamaWMS.WebUI.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="fixed-top">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="RollReservations" asp-action="Index">
                    <img src="~/img/LogoLama.png" alt="Главная" style="height: 30px;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Rolls" asp-action="Index">Рулоны</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Cells" asp-action="Index">Ячейки</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Fabrics" asp-action="Index">Ткани</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index">Изделия</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="RollReservations" asp-action="Index">Резервы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="RollTransactions" asp-action="Index">Транзакции</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3" style="padding-top: 75px;">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            <span id="lamaTrigger">&copy; 2026 - LamaWMS</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div id="lamaEasterEgg" class="lama-easter-egg">
        <div class="lama-message">
            Мее-е. Склад под контролем.
        </div>

        <img src="~/img/cute_lama.png"
             alt=""
             class="lama-image" />
    </div>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const trigger =
                    document.getElementById("lamaTrigger");

                const lama =
                    document.getElementById("lamaEasterEgg");

                if (!trigger || !lama)
                    return;

                let clickCount = 0;
                let resetTimer = null;
                let hideTimer = null;

                trigger.addEventListener("click", function () {

                    clickCount++;

                    clearTimeout(resetTimer);

                    // Если пользователь перестал кликать,
                    // последовательность сбрасывается.
                    resetTimer = setTimeout(function () {
                        clickCount = 0;
                    }, 2000);

                    if (clickCount < 5)
                        return;

                    clickCount = 0;

                    clearTimeout(resetTimer);
                    clearTimeout(hideTimer);

                    lama.classList.remove("show");

                    // Позволяет повторно запустить анимацию.
                    void lama.offsetWidth;

                    lama.classList.add("show");

                    hideTimer = setTimeout(function () {
                        lama.classList.remove("show");
                    }, 5000);
                });
            });
    </script>
</body>
</html>
