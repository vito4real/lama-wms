@model LamaWMS.Domain.Entities.Roll

@{
    ViewData["Title"] = "Списание ткани";

    var reservedLength =
        Model.Reservations.Sum(x => x.ReservedLength);

    var availableLength =
        Model.CurrentLength - reservedLength;
}

<h1>Списание ткани</h1>

<div class="alert alert-light border">
    <strong>Рулон:</strong> @Model.Number<br />
    <strong>Ткань:</strong> @Model.Fabric.Name<br />
    <strong>Физический остаток:</strong>
    @Model.CurrentLength.ToString("0.00") м<br />

    <strong>Зарезервировано:</strong>
    @reservedLength.ToString("0.00") м<br />

    <strong>Доступно для списания:</strong>
    @availableLength.ToString("0.00") м
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="WriteOff" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="rollId"
           value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">
            Списать, м
        </label>

        <input type="number"
               name="length"
               min="0.01"
               max="@availableLength.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               step="0.01"
               class="form-control"
               style="max-width: 300px;"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Причина списания
        </label>

        <textarea name="comment"
                  class="form-control"
                  rows="3"
                  placeholder="Например: повреждение ткани"
                  required></textarea>
    </div>

    <button type="submit"
            class="btn btn-danger">
        Списать
    </button>

    <a asp-controller="Rolls"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">
        Отмена
    </a>

</form>