@model LamaWMS.Domain.Entities.Roll

@{
    ViewData["Title"] = "Приход ткани";
}

<h1>Приход ткани</h1>

<div class="alert alert-light border">
    <strong>Рулон:</strong> @Model.Number<br />
    <strong>Ткань:</strong> @Model.Fabric.Name<br />
    <strong>Текущий остаток:</strong> @Model.CurrentLength.ToString("0.00") м
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="Receipt" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="rollId"
           value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">
            Количество, м
        </label>

        <input type="number"
               name="length"
               min="0.01"
               step="0.01"
               class="form-control"
               style="max-width: 300px;"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Комментарий
        </label>

        <textarea name="comment"
                  class="form-control"
                  rows="3"></textarea>
    </div>

    <button type="submit"
            class="btn btn-success">
        Оприходовать
    </button>

    <a asp-controller="Rolls"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">
        Отмена
    </a>

</form>