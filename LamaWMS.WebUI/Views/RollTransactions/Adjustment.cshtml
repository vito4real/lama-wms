@model LamaWMS.Domain.Entities.Roll

@{
    ViewData["Title"] = "Корректировка остатка";

    var reservedLength =
        Model.Reservations.Sum(x => x.ReservedLength);
}

<h1>Корректировка остатка</h1>

<div class="alert alert-light border">
    <strong>Рулон:</strong> @Model.Number<br />
    <strong>Ткань:</strong> @Model.Fabric.Name<br />
    <strong>Остаток в системе:</strong>
    @Model.CurrentLength.ToString("0.00") м<br />

    <strong>Зарезервировано:</strong>
    @reservedLength.ToString("0.00") м
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="Adjustment" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="rollId"
           value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">
            Фактический остаток, м
        </label>

        <input type="number"
               name="actualLength"
               value="@Model.CurrentLength.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               min="@reservedLength.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               step="0.01"
               class="form-control"
               style="max-width: 300px;"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Причина корректировки
        </label>

        <textarea name="comment"
                  class="form-control"
                  rows="3"
                  placeholder="Например: результат инвентаризации"
                  required></textarea>
    </div>

    <button type="submit"
            class="btn btn-warning">
        Скорректировать
    </button>

    <a asp-controller="Rolls"
       asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">
        Отмена
    </a>

</form>