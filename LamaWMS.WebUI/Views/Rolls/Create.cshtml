@model LamaWMS.Domain.Entities.Roll

@{
    ViewData["Title"] = "Новый рулон";
}

<h1>Новый рулон</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="FabricId" class="form-label">Ткань</label>

        <select asp-for="FabricId"
                class="form-select"
                asp-items="ViewBag.FabricId"
                id="fabricSelect">
            <option value="">-- Выберите ткань --</option>
        </select>

        <span asp-validation-for="FabricId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Номер рулона</label>

        <input id="rollNumber"
               class="form-control"
               value="Выберите ткань"
               readonly />
    </div>

    <div class="mb-3">
        <label asp-for="InitialLength" class="form-label">
            Начальная длина, м
        </label>

        <input asp-for="InitialLength"
               class="form-control"
               type="text"
               inputmode="decimal" />

        <span asp-validation-for="InitialLength"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CellId" class="form-label">Ячейка</label>

        <select asp-for="CellId"
                asp-items="ViewBag.CellId"
                class="form-select">
            <option value="">-- без ячейки --</option>
        </select>

        <span asp-validation-for="CellId"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Создать
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Назад
    </a>
</form>

@section Scripts {
    <script>
        const fabricSelect = document.getElementById('fabricSelect');
        const rollNumber = document.getElementById('rollNumber');

        async function updateRollNumber() {
            const fabricId = fabricSelect.value;

            if (!fabricId) {
                rollNumber.value = 'Выберите ткань';
                return;
            }

            rollNumber.value = '...';

            try {
                const response = await fetch(
                    '@Url.Action("GetNextNumber", "Rolls")'
                    + '?fabricId='
                    + encodeURIComponent(fabricId)
                );

                if (!response.ok) {
                    throw new Error('Ошибка получения номера рулона');
                }

                const data = await response.json();

                rollNumber.value = data.number;
            }
            catch {
                rollNumber.value = 'Ошибка';
            }
        }

        fabricSelect.addEventListener('change', updateRollNumber);

        if (fabricSelect.value) {
            updateRollNumber();
        }
    </script>
}