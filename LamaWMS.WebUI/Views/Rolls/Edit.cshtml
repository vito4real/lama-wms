@model LamaWMS.Domain.Entities.Roll

@{
    ViewData["Title"] = "Изменить рулон";
}

<h1>Изменить рулон</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="Number" class="form-label">
            Номер рулона
        </label>

        <input asp-for="Number"
               class="form-control" />

        <span asp-validation-for="Number"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="FabricId" class="form-label">
            Ткань
        </label>

        <select asp-for="FabricId"
                asp-items="ViewBag.FabricId"
                class="form-select">
        </select>

        <span asp-validation-for="FabricId"
              class="text-danger">
        </span>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="border rounded p-3">
                <div class="text-muted">
                    Начальная длина
                </div>

                <strong>
                    @Model.InitialLength.ToString("0.00") м
                </strong>
            </div>
        </div>

        <div class="col-md-6">
            <div class="border rounded p-3">
                <div class="text-muted">
                    Текущий остаток
                </div>

                <strong>
                    @Model.CurrentLength.ToString("0.00") м
                </strong>
            </div>
        </div>
    </div>

    <div class="alert alert-light border">
        Остаток рулона изменяется складскими операциями
        и не может быть отредактирован вручную.
    </div>

    <div class="mb-3">
        <label asp-for="CellId" class="form-label">
            Ячейка
        </label>

        <select asp-for="CellId"
                asp-items="ViewBag.CellId"
                class="form-select">

            <option value="">-- без ячейки --</option>
        </select>

        <span asp-validation-for="CellId"
              class="text-danger">
        </span>
    </div>

    <button type="submit" class="btn btn-primary">
        Сохранить
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Назад
    </a>
</form>