@model IEnumerable<LamaWMS.Domain.Entities.Roll>

@{
    ViewData["Title"] = "Рулоны";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Рулоны</h1>

    <a asp-action="Create" class="btn btn-primary">
        Добавить рулон
    </a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Номер</th>
            <th>Ткань</th>
            <th>Ячейка</<t></t>h>
            <th>Начальная длина</th>
            <th>Остаток</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.Number</strong>
                </td>

                <td>
                    @item.Fabric.Name
                </td>

                <td>
                    @(item.Cell?.Code ?? "Не размещён")
                </td>

                <td>
                    @item.InitialLength.ToString("0.00") м
                </td>

                <td>
                    <strong>
                        @item.CurrentLength.ToString("0.00") м
                    </strong>
                </td>

                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Открыть
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Изменить
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">
                        Удалить
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>