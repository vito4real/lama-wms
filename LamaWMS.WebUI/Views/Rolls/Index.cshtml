@model IEnumerable<LamaWMS.Domain.Entities.Roll>

@{
    ViewData["Title"] = "Рулоны";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Рулоны</h1>

    <a asp-action="Create" class="btn btn-primary">
        Добавить рулон
    </a>
</div>

<form method="get" class="mb-3">
    <div class="d-flex flex-column flex-sm-row gap-2">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control flex-grow-1"
               placeholder="Поиск по номеру, ткани или ячейке..." />

        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-primary">
                Найти
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Сбросить
                </a>
            }
        </div>

    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Номер</th>
            <th>Ткань</th>
            <th>Ячейка</th>
            <th>Начальная длина</th>
            <th>Физический остаток</th>
            <th>Доступно</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.Number</strong>
                </td>

                <td>
                    @item.Fabric.Name
                </td>

                <td>
                    @(item.Cell?.Code ?? "Не размещён")
                </td>

                <td>
                    @item.InitialLength.ToString("0.00") м
                </td>

                <td>
                    <strong>
                        @item.CurrentLength.ToString("0.00") м
                    </strong>
                </td>

                @{
                    var reservedLength =
                        item.Reservations.Sum(x => x.ReservedLength);

                    var availableLength =
                        item.CurrentLength - reservedLength;
                }

                <td>
                    <strong>@availableLength.ToString("0.00") м</strong>
                </td>

                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Открыть
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-primary">
                        Изменить
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-danger">
                        Удалить
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>