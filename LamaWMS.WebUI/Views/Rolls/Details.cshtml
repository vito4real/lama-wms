@model LamaWMS.Domain.Entities.Roll

@{
    ViewData["Title"] = "Рулон " + Model.Number;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Рулон @Model.Number</h1>

        <div class="text-muted">
            @Model.Fabric.Name — @Model.Fabric.Color
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-secondary">
        Назад
    </a>
</div>

<div class="row mb-4">

    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted">
                Ткань
            </div>

            <strong>
                @Model.Fabric.Name
            </strong>
        </div>
    </div>

    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="text-muted">
                Цвет
            </div>

            <strong>
                @Model.Fabric.Color
            </strong>
        </div>
    </div>

    <div class="col-md-2">
        <div class="border rounded p-3">
            <div class="text-muted">
                Ячейка
            </div>

            <strong>
                @(Model.Cell?.Code ?? "Не размещён")
            </strong>
        </div>
    </div>

    <div class="col-md-2">
        <div class="border rounded p-3">
            <div class="text-muted">
                Начальная длина
            </div>

            <strong>
                @Model.InitialLength.ToString("0.00") м
            </strong>
        </div>
    </div>

    <div class="col-md-2">
        <div class="border rounded p-3">
            <div class="text-muted">
                Остаток
            </div>

            <strong>
                @Model.CurrentLength.ToString("0.00") м
            </strong>
        </div>
    </div>

</div>

<div class="mb-3">
    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Изменить
    </a>
</div>

<h4>История операций</h4>

@if (!Model.Transactions.Any())
{
    <div class="alert alert-light border">
        Операций по рулону пока нет.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Операция</th>
                <th>Длина</th>
                <th>Комментарий</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var transaction in Model.Transactions
                .OrderByDescending(x => x.CreatedAt))
            {
                <tr>
                    <td>
                        @transaction.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </td>

                    <td>
                        @transaction.Type
                    </td>

                    <td>
                        @transaction.Length.ToString("0.00") м
                    </td>

                    <td>
                        @transaction.Comment
                    </td>
                </tr>
            }
        </tbody>
    </table>
}