@using LamaWMS.Domain.Enums
@model LamaWMS.Domain.Entities.Roll

@{
    ViewData["Title"] = "Рулон " + Model.Number;

    var reservedLength =
        Model.Reservations.Sum(x => x.ReservedLength);

    var availableLength =
        Model.CurrentLength - reservedLength;

    string GetTransactionName(RollTransactionType type)
    {
        return type switch
        {
            RollTransactionType.Receipt => "Приход",
            RollTransactionType.Consumption => "В производство",
            RollTransactionType.Return => "Возврат",
            RollTransactionType.WriteOff => "Списание",
            RollTransactionType.Adjustment => "Корректировка",
            _ => type.ToString()
        };
    }

    string GetTransactionLength(RollTransactionType type, decimal length)
    {
        return type switch
        {
            RollTransactionType.Receipt =>
                $"+{length:0.00} м",

            RollTransactionType.Return =>
                $"+{length:0.00} м",

            RollTransactionType.Consumption =>
                $"-{length:0.00} м",

            RollTransactionType.WriteOff =>
                $"-{length:0.00} м",

            RollTransactionType.Adjustment =>
                $"{(length > 0 ? "+" : "")}{length:0.00} м",

            _ => $"{length:0.00} м"
        };
    }
}

@* ============================================================
   Шапка рулона
   ============================================================ *@

<div class="d-flex justify-content-between align-items-start mb-4">

    <div>
        <div class="d-flex align-items-center gap-3">
            <h1 class="mb-1">
                Рулон @Model.Number
            </h1>
        </div>

        <div class="text-muted">
            <strong class="text-dark">
                @Model.Fabric.Name
            </strong>

            <span class="mx-2">•</span>

            Ячейка:
            <strong class="text-dark">
                @(Model.Cell?.Code ?? "Не размещён")
            </strong>
        </div>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Назад
    </a>

</div>


@* ============================================================
   Состояние рулона
   ============================================================ *@

<div class="card mb-3">
    <div class="card-body py-3">

        <div class="row g-3">

            <div class="col-6 col-md-3">
                <div class="text-muted small">
                    Начальная длина
                </div>

                <div class="fs-5 fw-semibold">
                    @Model.InitialLength.ToString("0.00") м
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="text-muted small">
                    Физический остаток
                </div>

                <div class="fs-5 fw-semibold">
                    @Model.CurrentLength.ToString("0.00") м
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="text-muted small">
                    Зарезервировано
                </div>

                <div class="fs-5 fw-semibold">
                    @reservedLength.ToString("0.00") м
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="text-muted small">
                    Доступно
                </div>

                <div class="fs-5 fw-semibold">
                    @availableLength.ToString("0.00") м
                </div>
            </div>

        </div>

    </div>
</div>


@* ============================================================
   Действия
   ============================================================ *@

<div class="d-flex gap-2 flex-wrap mb-4">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Изменить
    </a>

    <a asp-controller="RollTransactions"
       asp-action="Receipt"
       asp-route-rollId="@Model.Id"
       class="btn btn-success">
        Приход
    </a>

    <a asp-controller="RollTransactions"
       asp-action="Return"
       asp-route-rollId="@Model.Id"
       class="btn btn-outline-success">
        Возврат
    </a>

    <a asp-controller="RollTransactions"
       asp-action="WriteOff"
       asp-route-rollId="@Model.Id"
       class="btn btn-outline-danger">
        Списание
    </a>

    <a asp-controller="RollTransactions"
       asp-action="Adjustment"
       asp-route-rollId="@Model.Id"
       class="btn btn-outline-warning">
        Корректировка
    </a>

</div>

@* ============================================================
   Вкладки
   ============================================================ *@

<ul class="nav nav-tabs mb-3"
    id="rollTabs"
    role="tablist">

    <li class="nav-item"
        role="presentation">

        <button class="nav-link active"
                id="reservations-tab"
                data-bs-toggle="tab"
                data-bs-target="#reservations"
                type="button"
                role="tab">

            Резервы

            <span class="badge text-bg-secondary ms-1">
                @Model.Reservations.Count
            </span>

        </button>

    </li>

    <li class="nav-item"
        role="presentation">

        <button class="nav-link"
                id="transactions-tab"
                data-bs-toggle="tab"
                data-bs-target="#transactions"
                type="button"
                role="tab">

            История операций

            <span class="badge text-bg-secondary ms-1">
                @Model.Transactions.Count
            </span>

        </button>

    </li>

</ul>


<div class="tab-content"
     id="rollTabsContent">


    @* ========================================================
       Резервы
       ======================================================== *@

    <div class="tab-pane fade show active"
         id="reservations"
         role="tabpanel">

        @if (!Model.Reservations.Any())
        {
            <div class="alert alert-light border">
                Рулон ни под одно изделие не зарезервирован.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Изделие</th>
                            <th>Зарезервировано</th>
                            <th>Дата резерва</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var reservation in
                            Model.Reservations
                                .OrderByDescending(x => x.CreatedAt))
                        {
                            <tr>

                                <td>
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@reservation.ProductFabric.ProductId"
                                       class="text-decoration-none fw-semibold">

                                        @reservation.ProductFabric.Product.Name

                                    </a>
                                </td>

                                <td>
                                    <strong>
                                        @reservation.ReservedLength.ToString("0.00") м
                                    </strong>
                                </td>

                                <td class="text-muted">
                                    @reservation.CreatedAt
                                    .ToLocalTime()
                                    .ToString("dd.MM.yyyy HH:mm")
                                </td>

                                <td class="text-end">

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-controller="RollReservations"
                                           asp-action="Consume"
                                           asp-route-id="@reservation.Id"
                                           class="btn btn-sm btn-danger">

                                            Списать в производство

                                        </a>

                                        <form asp-controller="RollReservations"
                                              asp-action="Delete"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@reservation.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-secondary">

                                                Снять резерв

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>


    @* ========================================================
       История операций
       ======================================================== *@

    <div class="tab-pane fade"
         id="transactions"
         role="tabpanel">

        @if (!Model.Transactions.Any())
        {
            <div class="alert alert-light border">
                Операций по рулону пока нет.
            </div>
        }
        else
        {
            <div class="border rounded">

                <div class="table-responsive"
                     style="max-height: 430px; overflow-y: auto;">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Дата</th>
                                <th>Операция</th>
                                <th>Длина</th>
                                <th>Изделие</th>
                                <th>Комментарий</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var transaction in
                                Model.Transactions
                                    .OrderByDescending(x => x.CreatedAt))
                            {
                                <tr>

                                    <td class="text-nowrap text-muted">
                                        @(transaction.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                    </td>

                                    <td>
                                        @GetTransactionName(transaction.Type)
                                    </td>

                                    <td class="text-nowrap fw-semibold">
                                        @GetTransactionLength(
                                            transaction.Type,
                                            transaction.Length)
                                    </td>

                                    <td>
                                        @if (transaction.Product != null)
                                        {
                                            <a asp-controller="Products"
                                               asp-action="Details"
                                               asp-route-id="@transaction.ProductId"
                                               class="text-decoration-none">

                                                @transaction.Product.Name

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(
                                            transaction.Comment))
                                        {
                                            @transaction.Comment
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

    </div>

</div>