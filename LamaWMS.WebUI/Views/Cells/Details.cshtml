@model LamaWMS.Domain.Entities.Cell

@{
    ViewData["Title"] = "Ячейка " + Model.Code;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Ячейка @Model.Code</h1>
        <div class="text-muted">
            Рулонов: @Model.Rolls.Count
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        Назад
    </a>
</div>

@if (!Model.Rolls.Any())
{
    <div class="alert alert-light border">
        Ячейка пуста.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Рулон</th>
                <th>Ткань</th>
                <th>Цвет</th>
                <th>Остаток</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var roll in Model.Rolls.OrderBy(x => x.Number))
            {
                <tr>
                    <td>
                        <strong>@roll.Number</strong>
                    </td>

                    <td>
                        @roll.Fabric.Name
                    </td>

                    <td>
                        @roll.Fabric.Color
                    </td>

                    <td>
                        @roll.CurrentLength.ToString("0.00") м
                    </td>

                    <td class="text-end">
                        <a asp-controller="Rolls"
                           asp-action="Details"
                           asp-route-id="@roll.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Рулон
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}