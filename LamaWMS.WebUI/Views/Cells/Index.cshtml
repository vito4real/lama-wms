@model IEnumerable<LamaWMS.Domain.Entities.Cell>

@{
    ViewData["Title"] = "Ячейки";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Ячейки склада</h1>

    <a asp-action="Create" class="btn btn-primary">
        Добавить ячейку
    </a>
</div>

<form method="get" class="mb-3">
    <div class="d-flex flex-column flex-sm-row gap-2">

        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control flex-grow-1"
               placeholder="Поиск по коду ячейки..." />

        <div class="d-flex gap-2">
            <button type="submit"
                    class="btn btn-primary">
                Найти
            </button>

            @if (!string.IsNullOrWhiteSpace(ViewBag.Search))
            {
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Сбросить
                </a>
            }
        </div>

    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Код</th>
            <th>Рулонов</th>
            <th>Общий метраж</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cell in Model)
        {
            <tr>
                <td>
                    <strong>@cell.Code</strong>
                </td>

                <td>
                    @cell.Rolls.Count
                </td>

                <td>
                    <strong>
                        @cell.Rolls.Sum(x => x.CurrentLength).ToString("0.00") м
                    </strong>
                </td>

                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@cell.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Открыть
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@cell.Id"
                       class="btn btn-sm btn-outline-primary">
                        Изменить
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@cell.Id"
                       class="btn btn-sm btn-outline-danger">
                        Удалить
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>