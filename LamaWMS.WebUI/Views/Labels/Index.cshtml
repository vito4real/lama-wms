@model IEnumerable<LamaWMS.Domain.Entities.FurnitureLabel>
@{
    ViewData["Title"] = "Этикетки";
    var users = ViewBag.Users as Dictionary<string,string> ?? new();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>История этикеток</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Marker"))
    {
        <a asp-action="Create" class="btn btn-primary">Новая этикетка</a>
    }
</div>
<form method="get" class="d-flex gap-2 mb-3">
    <input class="form-control" name="search" value="@ViewBag.Search" placeholder="Заявка, наименование, обозначение" />
    <button class="btn btn-outline-secondary">Найти</button>
</form>
<table class="table table-striped table-hover align-middle">
    <thead><tr><th>Дата</th><th>Заявка</th><th>Изделие</th><th>Обозначение</th><th>Создал</th><th></th></tr></thead>
    <tbody>
    @foreach (var label in Model)
    {
        <tr>
            <td>@label.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
            <td>@label.RequestNumber</td>
            <td>@label.Complectation</td>
            <td>@label.Designation</td>
            <td>@(label.CreatedByUserId != null && users.TryGetValue(label.CreatedByUserId, out var name) ? name : "Не указан")</td>
            <td><a asp-action="Details" asp-route-id="@label.Id" class="btn btn-sm btn-outline-primary">Открыть</a></td>
        </tr>
    }
    </tbody>
</table>
